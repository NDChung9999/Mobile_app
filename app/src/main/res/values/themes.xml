<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Kinetic" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/surface_container_lowest</item>
        <item name="android:navigationBarColor">@color/surface_container_low</item>
        <item name="android:windowLightStatusBar">false</item>


        <item name="bottomNavigationStyle">@style/Widget.Kinetic.BottomNavigation</item>
    </style>

    <style name="Widget.Kinetic.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/surface_container_low</item>
        <item name="itemIconTint">@color/bottom_nav_item_color</item>
        <item name="itemTextColor">@color/bottom_nav_item_color</item>
        <item name="itemRippleColor">@color/primary_20</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Kinetic.BottomNavigation.ActiveIndicator</item>
    </style>

    <style name="Widget.Kinetic.BottomNavigation.ActiveIndicator">
        <item name="android:color">@color/surface_container_highest</item>
    </style>


    <style name="Widget.Kinetic.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface_container_low</item>
        <item name="boxStrokeColor">@color/outline_variant</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="hintTextColor">@color/on_surface_variant</item>
    </style>


    <style name="Widget.Kinetic.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="cornerRadius">12dp</item>
        <item name="elevation">0dp</item>
    </style>


    <style name="Widget.Kinetic.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/secondary</item>
        <item name="strokeColor">@color/outline_variant</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
    </style>


    <style name="Widget.Kinetic.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface_container_low</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeColor">@color/outline_variant</item>
        <item name="strokeWidth">0dp</item>
    </style>

</resources>
