<?xml version="1.0" encoding="utf-8"?>
<!-- item_workout_set.xml --><LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="2dp">


    <LinearLayout
        android:id="@+id/layout_exercise_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="4dp"
        android:paddingTop="20dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tv_exercise_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đẩy ngực ngang"
            android:textColor="@color/on_surface"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_muscle_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ngực and Tay sau"
            android:textColor="@color/secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.2" />
    </LinearLayout>


    <LinearLayout
        android:id="@+id/row_container"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/surface_container_low">


        <TextView
            android:id="@+id/tv_set_number"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:text="01"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:textStyle="bold" />


        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_weight"
            android:layout_width="80dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:hint="Kg"
            android:textColorHint="@color/on_surface_variant"
            android:inputType="numberDecimal"
            android:textAlignment="center"
            android:textColor="@color/on_surface"
            android:textSize="18sp"
            android:textStyle="bold" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="×"
            android:textColor="@color/on_surface_variant"
            android:textSize="16sp"
            android:layout_marginHorizontal="4dp" />


        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_reps"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:hint="Lần"
            android:textColorHint="@color/on_surface_variant"
            android:inputType="number"
            android:textAlignment="center"
            android:textColor="@color/on_surface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />


        <ImageButton
            android:id="@+id/btn_complete"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_check_btn"
            android:contentDescription="Hoàn thành hiệp"
            android:padding="6dp"
            android:src="@drawable/ic_check"
            tools:ignore="TouchTargetSizeCheck" />
    </LinearLayout>


    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/surface_container_highest"
        android:layout_marginHorizontal="16dp" />

</LinearLayout>